<Window x:Class="LuminanceCapture.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" Width="360" Height="64" Title="Luminance Capture Toast">
    <Border x:Name="Root" Background="#FF2B2B2B" BorderBrush="#FF555555" BorderThickness="1" Padding="16,8">
        <TextBlock x:Name="Message" Foreground="White" FontSize="15" VerticalAlignment="Center"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    </Border>
</Window>
