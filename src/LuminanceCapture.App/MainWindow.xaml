<Window x:Class="LuminanceCapture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luminance Capture" Icon="app.ico"
        Width="480" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="StatusText" FontSize="30" FontWeight="Bold" Text="흑백: 꺼짐"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ToggleButton" Content="흑백 켜기" Click="OnToggleClick"/>
            <Button x:Name="CaptureButton" Content="지금 캡처" Margin="10,0,0,0" Click="OnCaptureClick"/>
        </StackPanel>

        <TextBlock Style="{StaticResource Label}" Text="흑백 토글 단축키"/>
        <TextBox x:Name="ToggleBox" Style="{StaticResource HotkeyBox}"
                 PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyLostFocus" Tag="Toggle"/>
        <TextBlock Style="{StaticResource Label}" Text="캡처 단축키"/>
        <TextBox x:Name="CaptureBox" Style="{StaticResource HotkeyBox}"
                 PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyLostFocus" Tag="Capture"/>
        <TextBlock Foreground="Gray" FontSize="12" Margin="0,4,0,0"
                   Text="칸을 클릭한 뒤 원하는 키 조합을 누르세요. (Ctrl, Alt, Shift, Win 중 하나 이상 포함)"/>
        <TextBlock x:Name="MessageText" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

        <TextBlock Style="{StaticResource Label}" Text="저장 폴더"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" IsReadOnly="True" Padding="6,5" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="폴더 선택" Margin="8,0,0,0" Click="OnPickFolderClick"/>
            <Button Grid.Column="2" Content="폴더 열기" Margin="8,0,0,0" Click="OnOpenFolderClick"/>
        </Grid>

        <CheckBox x:Name="AutoStartBox" Content="윈도우 시작 시 자동 실행" Margin="0,18,0,0"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
        <CheckBox x:Name="SoundBox" Content="캡처 소리 재생" Margin="0,8,0,0"
                  Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

        <TextBlock Foreground="Gray" FontSize="12" Margin="0,18,0,0" Text="흑백 기준: Rec.709 휘도"/>
    </StackPanel>
</Window>
